<UserControl x:Class="MemoryMatchingGame.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MemoryMatchingGame.Views"
             xmlns:main="clr-namespace:MemoryMatchingGame"
             mc:Ignorable="d" >
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <StackPanel Grid.Column="2" VerticalAlignment="Top">
        <TextBlock Text="Options"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0 0 0 15"/>

        <TextBlock Text="Board Size"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0 0 0 5"/>

        <ComboBox ItemsSource="{Binding Difficulties}"
                  SelectedItem="{Binding SelectedDifficulty}"
                  DisplayMemberPath="Title"
                  Padding="8"
                  Background="White"
                  Width="180"
                  Margin="0 0 0 10"
                  HorizontalAlignment="Left"/>

        <TextBlock Text="Theme"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0 0 0 5"/>

        <ComboBox ItemsSource ="{Binding Categories}" 
                  SelectedItem="{Binding SelectedCategory}"
                  Padding="8"
                  Width="180"
                  Margin="0 0 0 10"
                  HorizontalAlignment="Left"/>

        <CheckBox Content="2 Players"
              IsChecked="{Binding IsTwoPlayersMode}"
              FontSize="14"
              Margin="0,0,0,10"/>
        

        
        <StackPanel Orientation="Horizontal">
            <Button Content="New Game" Command="{Binding RestartCommand}"
                    Background="#0066CC"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Padding="16,6"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Peek"
                    Command="{Binding PeekCommand}"
                    Margin="8,0,0,0"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Padding="16,6"
                    Background="White"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
        
        <Border Visibility="{Binding IsTwoPlayersMode, Converter={StaticResource BoolToVis}}"
                BorderBrush="LightGray" BorderThickness="1"
                CornerRadius="8"
                Margin="0 20 0 0">
            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="Turn"
                   Foreground="DodgerBlue"
                   FontWeight="Bold"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,2"/>

                <TextBlock Text="{Binding Turns.CurrentPlayer.PlayerNumber, StringFormat='Player {0}'}"
                   FontWeight="SemiBold"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>

                <TextBlock Foreground="DimGray"
                   FontSize="12"
                   HorizontalAlignment="Center" Margin="0 0 0 5">
            <Run Text="P1 "/><Run Text="{Binding Turns.Player1.Score}"/><Run Text=" • P2 "/><Run Text="{Binding Turns.Player2.Score}"/>
                </TextBlock>
            </StackPanel>
        </Border>
        
    </StackPanel>
</UserControl>
