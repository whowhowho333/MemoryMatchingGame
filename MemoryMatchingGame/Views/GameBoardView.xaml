<UserControl x:Class="MemoryMatchingGame.Views.GameBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MemoryMatchingGame.Views"
             mc:Ignorable="d">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Matching Pairs"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="20 10 0 15"/>

        <UniformGrid Grid.Row="1" Columns="4" Margin="20 0">
            <UniformGrid.Resources>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="LightGray"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="Margin" Value="3"/>
                </Style>
            </UniformGrid.Resources>

            <Border>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Moves" FontSize="16"
                                   FontWeight="SemiBold" Foreground="DodgerBlue"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Moves}" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Misses" FontSize="16"
                                   FontWeight="SemiBold" Foreground="DodgerBlue"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Misses}" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Accuracy" FontSize="16"
                                   FontWeight="SemiBold" Foreground="DodgerBlue"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Accuracy}" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Timer" FontSize="16"
                                   FontWeight="SemiBold" Foreground="DodgerBlue"
                                   HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ElapsedTimeString}" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            
        </UniformGrid>

        <Border Grid.Row="2" Margin="20">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding DataContext.ActiveRows,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Columns="{Binding DataContext.ActiveColumns,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.FlipCardCommand, 
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="3">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Background" Value="#F4F8FD"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="BorderThickness" Value="1.5" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="BorderBrush" Value="RoyalBlue" />
                                            <Setter Property="IsHitTestVisible" Value="False" />

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                            <Setter Property="Background" Value="#F0FBF1" />
                                            <Setter Property="BorderBrush" Value="#CDF1D4" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <Grid>
                                <TextBlock x:Name="MainContent"
                                               Text="?"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                <Image x:Name="CardImg"
                                       Source="{Binding Image}"
                                       Stretch="Uniform"
                                       Margin="6"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                <Setter TargetName="MainContent" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="CardImg" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                <Setter TargetName="MainContent" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="CardImg" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
