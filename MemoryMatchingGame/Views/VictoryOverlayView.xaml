<UserControl x:Class="MemoryMatchingGame.Views.VictoryOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MemoryMatchingGame.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#33000000">
        <Border Background="White"
                CornerRadius="16"
                Padding="25 15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="320">

            <StackPanel>
                <TextBlock Text="You matched them all!"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="Black"
                           Margin="0 0 0 15"/>

                <TextBlock FontSize="14" Foreground="#334155" 
                           FontWeight="Medium" Margin="0 0 0 10" >
                    <Run Text="{Binding ElapsedTimeString, Mode=OneWay}"/>
                    <Run Text=" • "/>
                    <Run Text="{Binding Moves}"/>
                    <Run Text="moves  • "/>
                    <Run Text="{Binding Misses}"/>
                    <Run Text="misses"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Play again" 
                            Command="{Binding RestartCommand}"
                            Padding="18,8"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#0284C7"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Close" 
                            Command="{Binding CloseOverlayCommand}"
                            Padding="16,8"
                            FontSize="14"
                            Foreground="#334155"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        
    </Border>
</UserControl>
